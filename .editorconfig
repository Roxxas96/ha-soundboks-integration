root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Tables and fenced code blocks (bash, Python) don't follow one indent rule — leave indent
# unenforced in markdown.
[*.md]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
max_line_length = off
